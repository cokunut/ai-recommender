// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  // NOTE: When using mysql or sqlserver, uncomment the @db.Text annotations in model Account below
  // Further reading:
  // https://next-auth.js.org/adapters/prisma#create-the-prisma-schema
  // https://www.prisma.io/docs/reference/api-reference/prisma-schema-reference#string
  url      = env("DATABASE_URL")
}

// Necessary for Next auth
model Account {
  id                       String  @id @default(cuid())
  userId                   String
  type                     String
  provider                 String
  providerAccountId        String
  refresh_token            String? // @db.Text
  access_token             String? // @db.Text
  expires_at               Int?
  token_type               String?
  scope                    String?
  id_token                 String? // @db.Text
  session_state            String?
  user                     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  refresh_token_expires_in Int?

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id               String            @id @default(cuid())
  name             String?
  email            String?           @unique
  emailVerified    DateTime?
  password         String?
  image            String?
  avatarUrl        String?
  profileText      String?
  createdAt        DateTime          @default(now())
  accounts         Account[]
  sessions         Session[]
  groupsCreated    Group[]           @relation("GroupCreatedBy")
  memberships      GroupMember[]
  pollsCreated     Poll[]            @relation("PollCreatedBy")
  pollChoicesAdded PollChoice[]      @relation("PollChoiceAddedBy")
  votes            Vote[]
  goodreadsImports GoodreadsImport[] @relation("GoodreadsImportUser")
  ratings          Rating[]
  reviews          Review[]
  readingTasteTags ReadingTasteTag[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// -----------------------------
// Bookclub domain models
// -----------------------------

enum GovernanceMode {
  OWNER_ADMIN
  ALL_MEMBERS
}

enum GroupRole {
  MEMBER
  ADMIN
  OWNER
}

enum PollSelectionType {
  AI_GENERATED
  USER_SELECTED
}

enum PollStatus {
  DRAFT
  ACTIVE
  CLOSED
}

enum GoodreadsImportStatus {
  PENDING
  PROCESSING
  DONE
  ERROR
}

enum ReadingRoundStatus {
  SETUP
  VOTING
  READING
  FINISHED
}

enum TagPreference {
  LIKE
  DISLIKE
}

model Group {
  id              String         @id @default(cuid())
  name            String
  description     String?
  governanceMode  GovernanceMode @default(OWNER_ADMIN)
  createdAt       DateTime       @default(now())
  createdByUserId String
  createdBy       User           @relation("GroupCreatedBy", fields: [createdByUserId], references: [id])
  members         GroupMember[]
  polls           Poll[]
  readingRounds   ReadingRound[]

  @@index([name])
}

model GroupMember {
  id       String    @id @default(cuid())
  groupId  String
  userId   String
  role     GroupRole @default(MEMBER)
  joinedAt DateTime  @default(now())
  group    Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([userId])
}

model Book {
  id            String         @id @default(cuid())
  title         String
  authors       String
  isbn          String?
  coverImageUrl String?
  description   String?
  externalIds   Json?
  createdAt     DateTime       @default(now())
  pollChoices   PollChoice[]
  winningPolls  Poll[]         @relation("WinningBook")
  readingRounds ReadingRound[]

  @@index([title])
}

model GoodreadsImport {
  id            String                @id @default(cuid())
  userId        String
  jsonData      Json
  status        GoodreadsImportStatus @default(PENDING)
  importedCount Int                   @default(0)
  createdAt     DateTime              @default(now())
  user          User                  @relation("GoodreadsImportUser", fields: [userId], references: [id], onDelete: Cascade)
}

model Poll {
  id              String            @id @default(cuid())
  groupId         String
  createdByUserId String
  selectionType   PollSelectionType @default(USER_SELECTED)
  status          PollStatus        @default(DRAFT)
  startsAt        DateTime?
  endsAt          DateTime?
  winningBookId   String?
  createdAt       DateTime          @default(now())

  group         Group          @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdBy     User           @relation("PollCreatedBy", fields: [createdByUserId], references: [id], onDelete: Cascade)
  choices       PollChoice[]
  votes         Vote[]
  winningBook   Book?          @relation("WinningBook", fields: [winningBookId], references: [id])
  readingRounds ReadingRound[]

  @@index([groupId])
}

model PollChoice {
  id            String   @id @default(cuid())
  pollId        String
  bookId        String
  addedByUserId String?
  createdAt     DateTime @default(now())

  poll    Poll   @relation(fields: [pollId], references: [id], onDelete: Cascade)
  book    Book   @relation(fields: [bookId], references: [id], onDelete: Cascade)
  addedBy User?  @relation("PollChoiceAddedBy", fields: [addedByUserId], references: [id])
  votes   Vote[]

  @@unique([pollId, bookId])
}

model Vote {
  id        String   @id @default(cuid())
  pollId    String
  choiceId  String
  userId    String
  createdAt DateTime @default(now())

  poll   Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  choice PollChoice @relation(fields: [choiceId], references: [id], onDelete: Cascade)
  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([pollId, userId])
  @@index([choiceId])
}

model ReadingRound {
  id            String             @id @default(cuid())
  groupId       String
  pollId        String?
  bookId        String?
  status        ReadingRoundStatus @default(SETUP)
  startedAt     DateTime?
  finishedAt    DateTime?
  createdAt     DateTime           @default(now())
  aiGroupReview String? // AI-synthesized review from all member reviews

  group   Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  poll    Poll?    @relation(fields: [pollId], references: [id])
  book    Book?    @relation(fields: [bookId], references: [id])
  ratings Rating[]
  reviews Review[]

  @@index([groupId])
}

model Rating {
  id             String   @id @default(cuid())
  readingRoundId String
  userId         String
  rating         Int // 1-5
  createdAt      DateTime @default(now())

  readingRound ReadingRound @relation(fields: [readingRoundId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([readingRoundId, userId])
  @@index([readingRoundId])
}

model Review {
  id             String   @id @default(cuid())
  readingRoundId String
  userId         String
  reviewText     String // User's review text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  readingRound ReadingRound @relation(fields: [readingRoundId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([readingRoundId, userId])
  @@index([readingRoundId])
}

model ReadingTasteTag {
  id         String        @id @default(cuid())
  userId     String
  label      String
  source     String // "ai" or "user"
  preference TagPreference @default(LIKE)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
